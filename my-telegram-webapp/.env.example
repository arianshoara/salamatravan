# Public OAuth client ID, not a client secret.
VITE_GOOGLE_CLIENT_ID=
# Same-origin JSON endpoint. Backend must verify the token and issue a secure session.
VITE_AUTH_ENDPOINT=/api/google-login
# Optional JSON object keyed by fa/en/de; entries: {"label":"service and country","url":"https://..."}.
# Populate only with reviewed services. UI language must not be used to infer a user's country.
VITE_CRISIS_RESOURCES={}
